{
  "compilerOptions": {
    // Modern JS-mål — Bun kör senaste JavaScript
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Tillåt import av .ts-filer direkt (Bun kör TypeScript utan bygg).
    // Kräver noEmit: true (vi har det längre ner).
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // JSX exists in the backend for ONE reason: @react-pdf/renderer describes
    // a PDF as a React tree (Document > Page > View > Text) and lays it out
    // with flexbox. No DOM, no browser — React is used here purely as a
    // declarative way to describe a document. See src/pdf/.
    "jsx": "react-jsx",

    // Strikt läge — fångar buggar innan koden körs. Ingen "any".
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    // Extra kvalitetskontroller
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Bun-specifikt: vi kör TS direkt, ingen output
    "noEmit": true,

    // Låt oss använda t.ex. JSON-import och moderna bibliotek
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Bun tillhandahåller sina egna typer
    "types": ["node"],
    "lib": ["ESNext"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
