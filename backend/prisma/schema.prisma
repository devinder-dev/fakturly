// schema.prisma — databasens sanning (source of truth).
// Här beskriver vi alla tabeller. Prisma genererar en typsäker klient
// och skapar migrationer (versionerad SQL) från den här filen.

generator client {
  provider     = "prisma-client" // Prisma 7: nya generatorn (utan -js), ESM-vänlig
  output       = "../src/generated/prisma" // krävs i Prisma 7 — genererad kod hamnar här
  moduleFormat = "esm" // vi kör ES Modules (import/export), passar Bun
}

datasource db {
  provider = "postgresql"
  // Prisma 7: ingen url här längre. URL:en bor i prisma.config.ts (för CLI/migrationer)
  // och i driver-adaptern (för runtime, se src/lib/prisma.ts senare).
}

// ─────────────────────────────────────────────────────────────
// Organizations — the tenant. Every row of a company's data points here.
// ─────────────────────────────────────────────────────────────

/// The company that issues invoices. Replaces the single seller that used to
/// live in env.COMPANY_*, so one deployment can serve many companies.
///
/// Required columns are what a Swedish invoice must state about the seller
/// (name, address, organisationsnummer) plus the address replies go to.
/// vatNumber is optional because not every business is VAT-registered;
/// bankgiro because a business may take card payments only.
model Organization {
  id   String @id @default(cuid())
  name String

  /// Stored normalised as NNNNNN-NNNN (see organization.validator.ts), so the
  /// unique index cannot be dodged by writing the same number without a dash.
  /// A CHECK constraint (migration tenant_scoped_data) enforces that format in
  /// the database too, below anything a raw-SQL script could do.
  orgNumber String  @unique
  vatNumber String?
  address   String
  email     String
  bankgiro  String?

  /// Godkänd för F-skatt — the invoice must say so when it is true.
  fSkatt           Boolean @default(true)
  /// Default payment terms for new invoices. 30 is the Swedish norm.
  paymentTermsDays Int     @default(30)

  users          User[]
  clients        Client[]
  invoices       Invoice[]
  transactions   Transaction[]
  auditLogs      AuditLog[]
  invoiceNumbers InvoiceNumberSeries[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Användare & roller
// ─────────────────────────────────────────────────────────────

model User {
  id             String          @id @default(cuid())
  email          String          @unique // the login identity, unique across all organizations (ADR 56)
  password       String // Argon2id-hash — aldrig lösenord i klartext
  role           Role            @default(CLIENT)
  failedLogins   Int             @default(0) // räknar misslyckade inloggningar
  lockedUntil    DateTime? // konto låst till denna tidpunkt

  /// When this login's owner last chose a password. NULL = never activated:
  /// the account exists only because a seller provisioned it, with a random
  /// password nobody knows. Recorded, not inferred from token rows — the demo
  /// seed sets passwords without any token, and token rows may be pruned.
  passwordSetAt  DateTime?

  // Staff belong to exactly one organization; a customer's login belongs to
  // NONE — it reaches its sellers through its Client rows, one per seller.
  // A CHECK constraint enforces it: ("role" = 'ADMIN') = ("organizationId" IS
  // NOT NULL). Restrict (the default) on delete: an organization that still
  // has staff cannot be deleted. Losing a tenant must be a deliberate act.
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One customer record per seller this login buys from.
  clients        Client[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  passwordTokens PasswordToken[]
  emailLogs      EmailLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
}

enum Role {
  ADMIN
  CLIENT
}

// ─────────────────────────────────────────────────────────────
// Kunder
// ─────────────────────────────────────────────────────────────

/// One seller's record of one customer. The same person buying from two
/// sellers has two Client rows — one in each organization — and one login.
model Client {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  address   String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Restrict)

  /// The login this customer uses for the portal. Shared by every seller the
  /// person buys from, so it is NOT unique here — only per organization.
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  invoices  Invoice[]
  createdAt DateTime  @default(now())

  // A seller has each customer once — by email and by login. Another seller
  // having the same customer is no conflict at all.
  @@unique([organizationId, email])
  @@unique([organizationId, userId])
  // The target of Invoice's composite foreign key: (id, organizationId) must
  // be unique before another table can reference the pair.
  @@unique([id, organizationId])
  @@index([organizationId, createdAt]) // an admin's client list, newest first
  @@index([userId]) // the portal: "every seller this login buys from"
}

// ─────────────────────────────────────────────────────────────
// Fakturor — raderas ALDRIG, endast status ändras
// ─────────────────────────────────────────────────────────────

model Invoice {
  id            String @id @default(cuid())
  // Unbroken series required by bokföringslagen. Format: "2026-0001".
  // Generated from InvoiceNumberSeries, never supplied by the caller.
  // Unique per organization, not globally: each company has its own series
  // (bokföringslagen), so Demo AB and Bergström both issue 2026-0001.
  invoiceNumber String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Restrict)

  // COMPOSITE foreign key: the client must exist IN THIS ORGANIZATION. A
  // plain clientId -> Client(id) key would accept company B's invoice
  // pointing at company A's client; this one makes that row impossible in
  // SQL, whatever the code above it gets wrong. Restrict on update: the
  // pair a row points at may never be rewritten underneath it.
  clientId String
  client   Client @relation(fields: [clientId, organizationId], references: [id, organizationId], onUpdate: Restrict)

  currency String        @default("SEK")
  status   InvoiceStatus @default(DRAFT)

  // A credit note (kreditfaktura) is an invoice with negative lines that
  // cancels an earlier one. It is a document of its own, in the SAME number
  // series — the law counts credit notes as invoices — and it points at what
  // it credits. The original is never edited; its status becomes CREDITED.
  type InvoiceType @default(INVOICE)

  creditsInvoiceId String?
  creditsInvoice   Invoice?  @relation("CreditNote", fields: [creditsInvoiceId], references: [id])
  creditNotes      Invoice[] @relation("CreditNote")

  // Three totals, all in öre, all derived from the line items.
  // A Swedish invoice must state net, VAT and gross separately — showing
  // only the total is not legally sufficient.
  netTotalOre   Int @default(0) // excluding VAT
  vatTotalOre   Int @default(0) // the VAT itself
  grossTotalOre Int @default(0) // what the client actually pays

  lateFeeOre Int @default(0) // dröjsmålsränta accrued so far, in öre

  // Statutory reminder fee (påminnelseavgift), 60 kr by lag (1981:739). At
  // most one per invoice, and only once a reminder has actually been sent —
  // reminderSentAt records when. Separate from lateFeeOre because the two
  // are different legal things: interest compensates for time, the fee for
  // the cost of chasing.
  reminderFeeOre Int       @default(0)
  reminderSentAt DateTime?

  issueDate DateTime  @default(now()) // fakturadatum — required on the invoice
  dueDate   DateTime
  sentAt    DateTime? // set once; after this the invoice is frozen
  paidAt    DateTime?

  stripePaymentId String?
  idempotencyKey  String?       @unique // prevents double payment processing
  items           InvoiceItem[]
  transactions    Transaction[]
  emailLogs       EmailLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, invoiceNumber])
  // Target of Transaction's composite foreign key.
  @@unique([id, organizationId])
  @@index([organizationId, createdAt]) // an admin's invoice list, newest first
  @@index([clientId, status]) // "this client's unpaid invoices"
  @@index([status, dueDate]) // the nightly overdue job — across organizations
}

// Per-year invoice numbering.
//
// Why a table rather than a Postgres sequence: a sequence cannot reset each
// year without running DDL at runtime. This row is incremented with a single
// atomic INSERT ... ON CONFLICT DO UPDATE ... RETURNING, which holds no long
// lock and does not serialise invoice creation.
//
// Gaps are possible if the surrounding transaction rolls back — the same
// property a sequence has. That is acceptable and explainable; what the law
// requires is that numbers are not reused or silently removed.
//
// One series per organization and year: the law wants an unbroken series per
// BUSINESS, so two companies on one deployment must not share a counter.
model InvoiceNumberSeries {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Restrict)
  year           Int
  lastNumber     Int          @default(0)

  @@id([organizationId, year])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  /// Cancelled by a credit note. Terminal — nothing is owed and nothing can
  /// happen to it again. The credit note itself carries the correction.
  CREDITED
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  // Cascade: deleting a DRAFT invoice removes its lines. A sent invoice can
  // never be deleted, so this only ever fires on drafts.
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description  String
  quantity     Int
  unitPriceOre Int // unit price in öre, EXCLUDING VAT

  // VAT rate in basis points: 2500 = 25.00%.
  //
  // Per line, not per invoice, because one invoice legitimately mixes rates —
  // consulting at 25% and a book at 6% on the same document.
  //
  // Basis points rather than a decimal, for the same reason money is öre:
  // 0.25 cannot be represented exactly in binary floating point.
  vatRate Int

  // All three stored rather than computed on read. An invoice is a financial
  // record: what it said when it was issued must not change because a
  // calculation was later corrected.
  netOre   Int // quantity * unitPriceOre
  vatOre   Int // rounded to whole öre, per line
  grossOre Int // netOre + vatOre

  /// Display order on the invoice.
  position Int @default(0)

  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────
// Transaktioner — IMMUTABLE. Uppdatera/radera aldrig. Nytt event = ny rad.
// ─────────────────────────────────────────────────────────────

model Transaction {
  id          String          @id @default(cuid())

  // Denormalised from the invoice. Safe here precisely because a transaction
  // is never updated: the copy cannot drift from its invoice. It lets every
  // ledger report filter by organization without joining Invoice.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Restrict)

  // Composite, like Invoice -> Client: a ledger row cannot point at another
  // organization's invoice.
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onUpdate: Restrict)
  type        TransactionType
  amountOre   Int // belopp i öre
  currency    String          @default("SEK")
  description String
  createdAt   DateTime        @default(now())
  // Inget updatedAt — transaktioner är oföränderliga

  @@index([organizationId, createdAt]) // ledger reports per organization
}

enum TransactionType {
  INVOICE_CREATED
  PAYMENT_RECEIVED
  LATE_FEE_ADDED
  /// Påminnelseavgift charged. Positive: the debt grew.
  REMINDER_FEE_ADDED
  /// A credit note cancelled this invoice. Negative, the invoice gross.
  CREDIT_NOTE_ISSUED
  /// Accrued interest written off — the invoice was credited. Negative.
  LATE_FEE_WAIVED
  /// Reminder fee written off — the invoice was credited. Negative.
  REMINDER_FEE_WAIVED
  REFUND
  ADJUSTMENT
}

// ─────────────────────────────────────────────────────────────
// E-postloggar
// ─────────────────────────────────────────────────────────────

// Record of every email we sent.
//
// invoiceId and userId are both optional because not every email belongs to an
// invoice: an invite or a password reset is about a person, not a document.
// The original model required invoiceId, which made those impossible to log.
model EmailLog {
  id String @id @default(cuid())

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  /// Where it was sent. Kept because a client's address can change later, and
  /// "which address did we actually send to" is the question that gets asked.
  recipient String

  type EmailType

  /// The provider's message id, when it accepted the send. Null means the
  /// attempt failed — the row is still written, because a reminder we failed
  /// to send is exactly what you need to know about.
  providerMessageId String?

  sentAt DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
  @@index([type, sentAt])
}

enum EmailType {
  INVOICE_SENT
  REMINDER
  OVERDUE_NOTICE
  PAYMENT_CONFIRMED
  INVITE
  PASSWORD_RESET
  /// A seller added an EXISTING login as its customer. Not an invite: the
  /// person already has a password, so there is nothing to set.
  CUSTOMER_ADDED
}

// ─────────────────────────────────────────────────────────────
// One-time tokens for setting a password
// ─────────────────────────────────────────────────────────────

/// Why an invite and a reset share one table: the mechanics are identical —
/// a single-use, expiring, hashed token that lets someone set a password
/// without knowing the old one. Two tables would mean two places to get the
/// expiry, the single-use check, or the hashing wrong.
enum PasswordTokenType {
  /// Sent when an admin provisions a client. Longer-lived — the recipient was
  /// not expecting it and may not read email for days.
  INVITE
  /// Requested by the user. Short-lived, because they are waiting for it.
  RESET
}

// ─────────────────────────────────────────────────────────────
// Webhook delivery log — idempotency at the EVENT level
// ─────────────────────────────────────────────────────────────

/// Stripe guarantees *at least once* delivery, not exactly once. The same
/// event will arrive twice if our response is slow, if we return a 5xx, or if
/// a network hiccup loses the acknowledgement — and Stripe retries for days.
///
/// Without this table, one payment webhook delivered twice marks the invoice
/// paid twice and writes two PAYMENT_RECEIVED rows. The ledger then says the
/// customer paid double.
///
/// Stripe's own event id is the primary key, so recording a delivery is a
/// plain INSERT: if it conflicts, we have already handled this event and can
/// stop. That check is atomic, which a SELECT-then-INSERT would not be.
///
/// Note this is a DIFFERENT concern from Invoice.idempotencyKey, which guards
/// the payment. This guards the delivery. Both are needed: the same payment
/// can arrive as two different events, and the same event can be delivered
/// twice.
model ProcessedWebhookEvent {
  /// The provider's event id, e.g. "evt_1abc...". Not a cuid — it is theirs.
  id String @id

  /// Which provider, so a second one later cannot collide on id format.
  provider String @default("stripe")

  /// e.g. "checkout.session.completed". Kept for debugging and metrics.
  type String

  processedAt DateTime @default(now())

  @@index([processedAt])
}

model PasswordToken {
  id String @id @default(cuid())

  /// SHA-256 of the token, never the token itself — same reasoning as
  /// RefreshToken. It is 256 random bits, so a slow hash buys nothing, and
  /// the lookup must be deterministic.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type      PasswordTokenType
  expiresAt DateTime

  /// Set when redeemed. The row is kept rather than deleted: a token being
  /// presented twice is worth seeing, and a deleted row would look identical
  /// to one that never existed.
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Revisionslogg (audit log) — raderas ALDRIG, lagkrav
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(cuid())

  // VALFRI (optional) — och det är hela poängen.
  // Ett misslyckat inloggningsförsök mot en e-post som INTE finns har
  // ingen användare att peka på. Just de försöken är det viktigaste vi
  // loggar: det är så man upptäcker credential stuffing (någon testar
  // läckta lösenord mot tusentals konton). Med userId som obligatorisk
  // gick de händelserna inte att spara alls.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Which organization the event belongs to. Nullable for the same reason as
  // userId: a failed login for an unknown email, or a customer's own login,
  // belongs to no single organization.
  // Restrict, not the optional-relation defaults (SET NULL on delete, CASCADE
  // on update): nothing done to an organization may ever rewrite an audit
  // row (append-only, ADR 2). Every organization key is ON UPDATE RESTRICT
  // for the same reason — an organization's id never changes.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Vilken e-post som FÖRSÖKTES, när ingen användare matchade.
  email String?

  action     String // t.ex. 'LOGIN_SUCCESS', 'LOGIN_FAILED', 'CREATE_INVOICE'
  resource   String // t.ex. 'Invoice', 'Client', 'User'
  resourceId String? // vilken specifik rad som påverkades
  ipAddress  String? // varifrån requesten kom
  userAgent  String? // vilken webbläsare/klient
  createdAt  DateTime @default(now())

  // Index = uppslagstabeller som gör sökningar snabba.
  // Utan dem måste Postgres läsa HELA tabellen, och en audit-logg
  // växer för alltid (den raderas aldrig — lagkrav).
  @@index([userId, createdAt]) // "visa allt användare X gjort"
  @@index([action, createdAt]) // "visa alla misslyckade inloggningar senaste timmen"
  @@index([email, createdAt]) // "attackeras den här e-posten?"
  @@index([organizationId, createdAt]) // an admin's audit view (phase 3)
}

// ─────────────────────────────────────────────────────────────
// Refresh tokens — långlivade tokens som ger nya access-tokens
// ─────────────────────────────────────────────────────────────

model RefreshToken {
  id String @id @default(cuid())

  // Vi sparar en SHA-256-HASH, aldrig själva token.
  // Läcker databasen kan ingen logga in med innehållet.
  //
  // Varför SHA-256 här men Argon2id för lösenord? Matcha hashen mot
  // entropin i det du hashar. En refresh token är 256 slumpbitar från
  // en CSPRNG — det finns ingenting att gissa, så en långsam hash ger
  // noll extra säkerhet men gör varje refresh dyr. Ett lösenord är
  // människovalt och gissningsbart — där ÄR långsamheten hela poängen.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Alla tokens som härstammar från EN inloggning delar familj.
  // Upptäcker vi stöld river vi hela familjen på en gång.
  familyId String

  expiresAt DateTime
  rotatedAt DateTime? // sattes när denna token byttes mot ett nytt par
  revokedAt DateTime? // spärrad (utloggning eller upptäckt stöld)

  // Forensik: varifrån kom den? Skiljer sig IP mellan utfärdande och
  // användning är det en stark signal om att något är fel.
  createdByIp String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt]) // för städjobbet som rensar utgångna tokens
}
