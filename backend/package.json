{
  "name": "fakturly-backend",
  "version": "0.1.0",
  "description": "Fakturly API \u2014 Fastify + TypeScript backend",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "seed": "bun prisma/seed.ts",
    "seed:demo": "bun prisma/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/bun": "^10.75.2",
    "bullmq": "^6.3.8",
    "dotenv": "^17.4.2",
    "fast-jwt": "^6.3.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "resend": "^6.28.1",
    "stripe": "~22.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "find-my-way": "^9.7.0",
    "mysql2": "^3.24.4"
  }
}
