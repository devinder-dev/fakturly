# backend/.env.example — MALL (säker att committa).
# Kopiera till .env och fyll i riktiga värden:  cp .env.example .env

# Databas
DATABASE_URL="postgresql://user:password@localhost:5432/fakturly"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth — generera en lång slumpmässig sträng (minst 32 tecken)
JWT_SECRET="change_me_to_a_long_random_secret_min_32_chars"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."

# App
PORT=3000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# ── Fakturautställare — trycks på varje PDF ──────────────────
# Standardvärdena är ett fiktivt bolag så att demo och lokal utveckling
# ger en komplett faktura utan inställningar. Byt ut i produktion.
COMPANY_NAME="Fakturly Demo AB"
COMPANY_ADDRESS="Sveavägen 1, 111 57 Stockholm"
COMPANY_ORG_NUMBER="559123-4567"
COMPANY_VAT_NUMBER="SE559123456701"
COMPANY_EMAIL="faktura@fakturly.se"
COMPANY_BANKGIRO="123-4567"

# ── Demo-läge ────────────────────────────────────────────────
# "true" publicerar demokontona på GET /demo och återställer databasen
# varje natt kl 03:00. ALDRIG i en riktig installation.
DEMO_MODE="false"
