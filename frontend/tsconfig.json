{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Same strictness as the backend. A frontend that quietly allows `any`
    // is where the shapes returned by the API stop being checked at all.
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Vite compiles; tsc only checks.
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Imports carry their extension — './api.ts', not './api'. Same as the
    // backend, so the two halves of the project read the same way.
    //
    // Only legal alongside noEmit: tsc would otherwise have to rewrite the
    // specifier on the way out, and it refuses to. Vite resolves it fine.
    "allowImportingTsExtensions": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
